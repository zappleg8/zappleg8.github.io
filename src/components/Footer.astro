---
import { LINKS } from '../consts';

const items = [
  { label: 'Email', href: LINKS.email },
  { label: 'LinkedIn', href: LINKS.linkedin },
  { label: 'X', href: LINKS.x },
  { label: 'GitHub', href: LINKS.github },
  { label: 'Surfing', href: LINKS.surfing },
];
---

<footer class="footer">
  <div class="footer-inner container">
    {
      items.map((item) => (
        <a href={item.href} class="footer-link" rel="me noopener">
          {item.label}
        </a>
      ))
    }
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: 80px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    padding-block: 28px;
  }
  .footer-link {
    color: var(--text-secondary);
    font-size: 12.5px;
    font-weight: 500;
  }
  .footer-link:hover {
    color: var(--accent);
  }
</style>
