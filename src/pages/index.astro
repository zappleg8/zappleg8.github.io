---
import BaseLayout from '../layouts/BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { SITE, LINKS } from '../consts';
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="home container">
    <div class="hero">
      <h1 class="name">Zach Applegate</h1>
      <p class="tagline">building agent harnesses in unsexy industries</p>
      <p class="location">based in Los Angeles</p>
    </div>

    <div class="surf">
      <span class="surf-label">surfing</span>
      <YouTubeEmbed id="D1HbkcQ8xfQ" title="Zach Applegate surfing" />
    </div>

    <p class="contact">
      <a href={LINKS.email}>email</a> or <a href={LINKS.x}>dm</a> to chat
    </p>
  </section>
</BaseLayout>

<style>
  .home {
    padding-block: 110px 60px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .name {
    font-size: clamp(40px, 8vw, 52px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .tagline {
    font-size: clamp(20px, 4vw, 24px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-top: 18px;
  }
  .location {
    font-size: 15px;
    color: var(--text-secondary);
    margin-top: 12px;
  }
  .surf-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 14px;
  }
  .contact {
    font-size: 16px;
    color: var(--text-secondary);
  }
  .contact a {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-underline);
  }
</style>
