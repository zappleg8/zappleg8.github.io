---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Zach Applegate"
  description="About Zach Applegate — building agent harnesses in unsexy industries."
>
  <section class="about container">
    <h1>About</h1>
    <p class="tagline">building agent harnesses in unsexy industries</p>

    <dl class="bio">
      <dt>from</dt>
      <dd>
        <span class="pill pill-place">Solana Beach, CA</span>
      </dd>

      <dt>went to</dt>
      <dd>
        <span class="pill pill-org">Cal Poly SLO</span>
        <span class="conn">studying</span>
        <span class="pill pill-field">engineering</span>
      </dd>

      <dt>started work in</dt>
      <dd>
        <span class="pill pill-place">Hong Kong</span>
        <span class="conn">for</span>
        <span class="pill pill-org">Diginex</span>
        <span class="conn">doing</span>
        <span class="pill pill-field">crypto</span>
      </dd>

      <dt>then</dt>
      <dd>
        <span class="pill pill-place">New York</span>
        <span class="conn">for</span>
        <span class="pill pill-org">Diginex</span>
        <span class="conn">doing</span>
        <span class="pill pill-field">crypto</span>
      </dd>

      <dt>then</dt>
      <dd>
        <span class="pill pill-place">Mozambique</span>
        <span class="conn">for</span>
        <span class="pill pill-org">Southern Minerals</span>
        <span class="conn">doing</span>
        <span class="pill pill-field">critical minerals</span>
      </dd>

      <dt>now</dt>
      <dd>
        <span class="pill pill-place">Los Angeles</span>
        <span class="conn">for</span>
        <span class="pill pill-org">Tires Easy</span>
        <span class="conn">doing</span>
        <span class="pill pill-field">ai</span>
      </dd>
    </dl>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: 80px;
  }
  .about h1 {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .tagline {
    font-size: 18px;
    color: var(--text-secondary);
    margin-top: 14px;
    margin-bottom: 44px;
  }
  .bio {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 24px;
    margin: 0;
    max-width: 640px;
  }
  dt {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 13px;
    align-self: baseline;
    white-space: nowrap;
    padding-top: 4px;
  }
  dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 15px;
  }
  .conn {
    color: var(--text-dim);
    font-size: 14px;
    padding-inline: 2px;
  }
  @media (max-width: 540px) {
    .bio {
      grid-template-columns: 1fr;
      gap: 4px 0;
    }
    dt {
      padding-top: 18px;
    }
    dt:first-of-type {
      padding-top: 0;
    }
  }
</style>
